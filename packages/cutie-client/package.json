{
  "name": "@openstax/cutie-client",
  "description": "Client-side QTI v3 rendering library for interactive assessment items",
  "version": "1.0.1",
  "dependencies": {
    "dompurify": "^3.3.1",
    "mathlive": "^0.98.0",
    "quill": "^2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jsdom": "^27.0.0",
    "cspell": "^5.18.5",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^27.4.0",
    "npm-run-all2": "^9.0.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^1.2.0"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./*": {
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "main": "index.js",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openstax/cutie.git",
    "directory": "packages/cutie-client"
  },
  "scripts": {
    "build": "./script/build.bash",
    "build:clean": "npm run clean && npm run build",
    "ci": "CI=true npm-run-all ci:*",
    "ci:lint": "eslint --max-warnings=0 .",
    "ci:spelling": "cspell -c ../../cspell.json \"**\"",
    "ci:test": "vitest run",
    "ci:typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "sideEffects": true,
  "type": "module",
  "types": "index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/esm/*",
        "dist/esm/*.d.ts",
        "dist/esm/*/index.d.ts"
      ]
    }
  }
}
